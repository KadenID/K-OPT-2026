<Window x:Class="Kopt2026.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kopt2026.App"
        Title="K-OPT 2026" Height="780" Width="1240" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <local:ResultNumberConverter x:Key="ResultNumberConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding CancelCommand}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding ValidateCommand}" />
    </Window.InputBindings>
    <DockPanel Background="#F1F5F9">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_파일">
                <MenuItem Header="_새 문서" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="_열기…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem Header="_저장" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="다른 이름으로 저장…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="결과 내보내기…" Click="Export_Click" />
                <MenuItem Header="종료" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_실행">
                <MenuItem Header="문서 검증" Command="{Binding ValidateCommand}" InputGestureText="Ctrl+Shift+B" />
                <MenuItem Header="최적화 실행" Command="{Binding RunCommand}" InputGestureText="F5" />
                <MenuItem Header="실행 취소" Command="{Binding CancelCommand}" InputGestureText="Shift+F5" />
            </MenuItem>
            <MenuItem Header="_설정">
                <MenuItem x:Name="KoreanTermsMenuItem" Header="결과 표 항목을 한글로 표시" IsCheckable="True" IsChecked="True" Click="KoreanTerms_Click" />
                <MenuItem x:Name="GraphInterceptsMenuItem" Header="그래프에 X·Y절편 표시" IsCheckable="True" IsChecked="True" Click="GraphIntercepts_Click" />
            </MenuItem>
            <MenuItem Header="_도움말"><MenuItem Header="K-OPT 2026 정보" Click="About_Click" /></MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#0F172A" Foreground="White">
            <StatusBarItem Content="{Binding EncodingText}" />
            <Separator />
            <StatusBarItem Content="{Binding StatusText}" />
            <Separator />
            <StatusBarItem Content="HiGHS 1.15.1" HorizontalAlignment="Right" />
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top" Background="White">
            <ToolBar>
                <Button Content="새로 만들기" Click="New_Click" AutomationProperties.Name="새 문서" />
                <Button Content="열기" Click="Open_Click" AutomationProperties.Name="문서 열기" />
                <Button Content="저장" Click="Save_Click" AutomationProperties.Name="문서 저장" />
                <Separator />
                <Button Content="검증" Command="{Binding ValidateCommand}" AutomationProperties.Name="문서 검증" />
                <Button Content="▶ 실행" Command="{Binding RunCommand}" Background="{StaticResource AccentBrush}" Foreground="White" AutomationProperties.Name="최적화 실행" />
                <Button Content="■ 중지" Command="{Binding CancelCommand}" AutomationProperties.Name="최적화 중지" />
            </ToolBar>
        </ToolBarTray>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkspaceRow" Height="3*" MinHeight="285" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="ResultsRow" Height="2*" MinHeight="180" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="600" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="EditorOutputGrid" Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="220" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition x:Name="LegacyOutputColumn" Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="모델 편집기" FontWeight="SemiBold" Padding="12,9" Background="#F8FAFC" />
                        <TextBox x:Name="ModelEditorTextBox" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="15" Padding="12" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="False" AutomationProperties.Name="OPT 모델 편집기" />
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="EditorOutputSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Cursor="SizeWE"
                              Background="#CBD5E1"
                              ToolTip="모델 편집기와 원본 K-OPT 형식 출력의 너비를 조절합니다."
                              AutomationProperties.Name="편집기와 원본 출력 너비 조절" />
                <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="#EFF6FF">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="원본 K-OPT 형식 출력" FontWeight="SemiBold" Padding="12,9" />
                            <TextBlock Grid.Column="1" Text="호환 보기" Foreground="#1D4ED8" FontSize="11" Padding="8,10,12,8" />
                        </Grid>
                        <TextBox x:Name="LegacyKoptOutputTextBox" Text="{Binding LegacyKoptOutputText, Mode=OneWay}" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" TextWrapping="NoWrap" AcceptsReturn="True" Padding="12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#F8FAFC" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="원본 K-OPT 형식 호환 출력" />
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter x:Name="OverviewSplitter" Grid.Row="0" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Cursor="SizeWE"
                          Background="Transparent" ToolTip="작업 영역과 문제 개요 영역의 너비를 조절합니다."
                          AutomationProperties.Name="작업 영역과 문제 개요 너비 조절" />
            <StackPanel Grid.Row="0" Grid.Column="2">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="문제 개요" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding OverviewText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="목적값" Foreground="#475569" />
                        <TextBlock Text="{Binding ObjectiveText}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AlternativeSummaryText}" Foreground="#B45309" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,10,0,0">
                    <TextBlock Text="기본 변수 범위는 0 이상입니다. F5로 현재 편집본을 저장하지 않고 바로 실행할 수 있습니다." TextWrapping="Wrap" Foreground="#1E3A8A" />
                </Border>
            </StackPanel>

            <GridSplitter x:Name="MainHorizontalSplitter" Grid.Row="1" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Cursor="SizeNS"
                          Background="#CBD5E1" ToolTip="상단 작업 영역과 하단 결과 영역의 높이를 조절합니다."
                          AutomationProperties.Name="상단 작업 영역과 결과 영역 높이 조절" />
            <TabControl Grid.Row="2" Grid.ColumnSpan="3" Background="White">
                <TabItem Header="진단">
                    <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" AutomationProperties.Name="문법 진단 목록">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="90" />
                            <DataGridTextColumn Header="수준" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="행" Binding="{Binding Span.Line}" Width="55" />
                            <DataGridTextColumn Header="열" Binding="{Binding Span.Column}" Width="55" />
                            <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="2*" />
                            <DataGridTextColumn Header="수정 힌트" Binding="{Binding Hint}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="변수 해">
                    <DataGrid x:Name="VariablesGrid" ItemsSource="{Binding Variables}" AutoGenerateColumns="False" AutomationProperties.Name="변수 해 결과">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="변수 유형" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="최적값" Binding="{Binding Value, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                            <DataGridTextColumn Header="수정비용" Binding="{Binding ReducedCost, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="제약식">
                    <DataGrid x:Name="ConstraintsGrid" ItemsSource="{Binding Constraints}" AutoGenerateColumns="False" AutomationProperties.Name="제약식 결과">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="관계식" Binding="{Binding Relation}" Width="*" />
                            <DataGridTextColumn Header="좌변 계산값" Binding="{Binding Activity, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                            <DataGridTextColumn Header="우변" Binding="{Binding RightHandSide, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                            <DataGridTextColumn Header="여유·잉여" Binding="{Binding Slack, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                            <DataGridTextColumn Header="쌍대값(잠재가격)" Binding="{Binding Dual, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="SensitivityTab" Header="민감도 분석">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SensitivitySummaryText}" Foreground="#1E3A8A" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="목적식 계수" Padding="6">
                            <DataGrid x:Name="ObjectiveSensitivityGrid" ItemsSource="{Binding ObjectiveSensitivity}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="목적식 계수 민감도 범위">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="변수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="현재계수" Binding="{Binding CurrentValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                    <DataGridTextColumn Header="하한" Binding="{Binding LowerValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                    <DataGridTextColumn Header="상한" Binding="{Binding UpperValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="2" Header="제약식 우변" Padding="6">
                            <DataGrid x:Name="RightHandSideSensitivityGrid" ItemsSource="{Binding RightHandSideSensitivity}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="제약식 우변 민감도 범위">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="제약식" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="현재우변" Binding="{Binding CurrentValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                    <DataGridTextColumn Header="하한" Binding="{Binding LowerValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                    <DataGridTextColumn Header="상한" Binding="{Binding UpperValue, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem Header="그래프">
                    <Grid Background="White">
                        <local:SolutionGraph Model="{Binding LatestModel}" Result="{Binding LatestResult}" UseKoreanTerms="{Binding UseKoreanResultTerms}" ShowIntercepts="{Binding ShowGraphIntercepts}"
                                             MinHeight="210" AutomationProperties.Name="최적화 결과 그래프" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="AlternativeOptimaTab" Header="복수 최적해">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <TextBlock Text="{Binding AlternativeSummaryText}" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <DataGrid x:Name="OptimalRangesGrid" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OptimalRanges}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="최적해 변수 범위">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="변수" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="최소" Binding="{Binding Minimum, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                <DataGridTextColumn Header="최대" Binding="{Binding Maximum, Converter={StaticResource ResultNumberConverter}}" Width="*" />
                                <DataGridTextColumn Header="최적 범위" Binding="{Binding Range}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="AlternativeSolutionsGrid" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AlternativeSolutions}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="대표 최적해 목록">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="55" />
                                <DataGridTextColumn Header="대표 최적해 변수값" Binding="{Binding Values}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="로그"><ListBox ItemsSource="{Binding Logs}" FontFamily="Cascadia Mono, Consolas" Padding="8" AutomationProperties.Name="실행 로그" /></TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
